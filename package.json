{
  "name": "@lichen/dsh-codex-subscribe",
  "version": "0.4.0",
  "description": "Independent Codex subscription providers with optional text-to-image and image editing",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/0xlic/dsh-codex-subscribe.git" },
  "homepage": "https://github.com/0xlic/dsh-codex-subscribe#readme",
  "bugs": { "url": "https://github.com/0xlic/dsh-codex-subscribe/issues" },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src/*.js", "client.js", "locale/*.json", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-tool", "@deepseek-ai/dsh-client-ui-attachment"]
    }
  },
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.2-rc.1 <0.2.3-0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "scripts": { "test:catalog-runtime": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" tests/catalog-runtime.cjs", "test:storage-runtime": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" tests/storage-domain-runtime.cjs", "test:web-runtime": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" tests/web-search-runtime.cjs", "test": "node --test tests/*.test.js", "check": "node --check src/index.js && node --check src/adapter.js && node --check src/subscriptions.js && node --check src/chat-account.js && node --check src/chat-failover.js && node --check src/codex-usage.js && node --check src/usage-cache.js && node --check src/model-catalog.js && node --check src/model-catalog-store.js && node --check src/images.js && node --check src/image-export.js && node --check src/image-settings.js && node --check src/image-accounts.js && node --check client.js && node --test tests/*.test.js" },
  "devDependencies": { "@earendil-works/pi-ai": "1.3.0" }
}
